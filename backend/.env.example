# ===================== API keys =====================
GROQ_API_KEY=
TAVILY_API_KEY=

# ===================== LLM provider =====================
# "groq" = cloud models (needs GROQ_API_KEY) | "ollama" = local models (needs Ollama running)
LLM_PROVIDER=groq
# Optional per-agent override (empty = use LLM_PROVIDER), e.g. a local planner with cloud verifier/synthesizer
PLANNER_PROVIDER=
VERIFIER_PROVIDER=
SYNTHESIZER_PROVIDER=

# ===================== Ollama (local models) =====================
# Used by any agent whose provider is "ollama". See your models with: ollama list
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_PLANNER_MODEL=qwen3:4b
OLLAMA_VERIFIER_MODEL=qwen3:8b
OLLAMA_SYNTHESIZER_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300              # seconds; local models can be slow on CPU
OLLAMA_REASONING_EFFORT=none    # qwen3 thinking: none = fastest (~20x) | low | medium | high

# ===================== Feature switches =====================
ENABLE_RAG=true
ENABLE_WEB_SEARCH=true          # false (or no TAVILY_API_KEY) disables the UI web-search button
ENABLE_VERIFIER=true
ENABLE_RERANKER=true

# ===================== Planner agent (greeting or search? + search query) =====================
PLANNER_MODEL=llama-3.3-70b-versatile          # used when the planner's provider is groq
PLANNER_TEMPERATURE=0.0
ENABLE_QUERY_REWRITE=true       # search with the planner's standalone query
HISTORY_TURNS=6

# ===================== Verifier agent =====================
VERIFIER_MODEL=openai/gpt-oss-120b          # used when the verifier's provider is groq
VERIFIER_TEMPERATURE=0.0
VERIFIER_MAX_TOKENS=2000
VERIFIER_MIN_CONFIDENCE=0.5     # below this the sources are treated as not enough to answer
BLOCK_EXPLICIT_CONTENT=true

# ===================== Synthesizer agent =====================
SYNTHESIZER_MODEL=openai/gpt-oss-120b       # used when the synthesizer's provider is groq
SYNTHESIZER_TEMPERATURE=0.4
SYNTHESIZER_MAX_TOKENS=2500

# ===================== Embeddings / reranker (local, fastembed) =====================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_FILE=onnx/model_int8.onnx   # int8 ~570 MB; onnx/model_fp16.onnx ~1.1 GB; onnx/model.onnx full ~2.2 GB
# MODEL_CACHE_DIR=./data/models

# ===================== Semantic chunking =====================
CHUNK_BREAKPOINT_PERCENTILE=90
CHUNK_BUFFER_SIZE=1
CHUNK_MIN_CHARS=200
CHUNK_MAX_CHARS=1800

# ===================== Vector DB (ChromaDB) =====================
CHROMA_HOST=                    # empty = embedded DB at CHROMA_PATH; set to use a Chroma server
CHROMA_PORT=8001
# CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=documents

# ===================== BM25 keyword search =====================
BM25_K1=1.5                     # term-frequency saturation
BM25_B=0.75                     # document-length normalisation
BM25_STEMMING=true

# ===================== Hybrid search + rerank =====================
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
HYBRID_CANDIDATES=15
RERANK_TOP_N=5
RERANK_MIN_SCORE=-8.0         # cross-encoder logit; irrelevant chunks score around -11

# ===================== Web search (Tavily) =====================
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced
TAVILY_INCLUDE_ANSWER=false

# ===================== Server (uvicorn) =====================
HOST=127.0.0.1                  # 0.0.0.0 to expose on your network
PORT=8000                       # if changed, set VITE_API_URL=http://localhost:<port> for the frontend
RELOAD=false                    # true = auto-restart on code changes (dev)
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
